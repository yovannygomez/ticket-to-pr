{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)"
    ],
    "deny": [
      "Edit(./tests/**)",
      "Write(./tests/**)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
