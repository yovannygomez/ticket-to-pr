# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=tickets

# fake = in-memory adapters, no external calls. Real adapters come next.
ADAPTERS=fake

# Jira (real adapters)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=

# GitHub (real adapters)
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Anthropic: a key from its own workspace with a spend limit
ANTHROPIC_API_KEY=

# LangFuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
