# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=tickets

# fake = in-memory adapters, no external calls; real = Jira, GitHub, Claude.
ADAPTERS=fake
WORKSPACES_DIR=~/.ticket-to-pr/workspaces
SANDBOX_IMAGE=ticket-to-pr-sandbox:dev
FAST_MODEL=claude-haiku-5-5
STRONG_MODEL=claude-sonnet-5-5

# Jira (real adapters)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=

# GitHub (real adapters): a fine-grained token for GITHUB_REPOSITORY only
GITHUB_TOKEN=
GITHUB_REPOSITORY=yovannygomez/listings-api
REVIEWER=yovannygomez

# Anthropic: a key from its own workspace with a spend limit
ANTHROPIC_API_KEY=

# LangFuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
